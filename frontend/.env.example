# ─── Backend Version Flag ─────────────────────────────────────────────────────
# Controls which API backend the frontend targets.
# Leave unset (or set to anything other than "node") → Python :8000 (safe default)
# Set to "node"  → Node.js Fastify :4000
NEXT_PUBLIC_BACKEND_VERSION=

# ─── Backend API URLs ─────────────────────────────────────────────────────────
NEXT_PUBLIC_NODE_API_URL=http://localhost:4000
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000

# ─── Resolved URL (auto-selected by NEXT_PUBLIC_BACKEND_VERSION above) ───────
# Do NOT set this directly — it is derived in lib/api-client.ts
# NEXT_PUBLIC_API_URL is kept for legacy direct fetch() calls in pages
NEXT_PUBLIC_API_URL=http://localhost:8000
