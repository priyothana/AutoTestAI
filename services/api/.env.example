# =============================================
# AutoTest AI - Node.js Backend Environment
# =============================================

# Server
PORT=4000
NODE_ENV=development

# Database (Prisma — no +asyncpg prefix)
DATABASE_URL=postgresql://postgres:postgres@db:5432/autotestdb

# Redis (BullMQ)
REDIS_URL=redis://redis:6379

# Auth / JWT
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI
OPENAI_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# LLM defaults
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-5

# Salesforce
SALESFORCE_ENCRYPTION_KEY=
SALESFORCE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/salesforce/callback

# Self-healing
HEALING_THRESHOLD=0.85

# Jira (optional)
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Notifications (optional)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
