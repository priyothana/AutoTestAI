{
  "name": "autotest-ai-api",
  "version": "1.0.0",
  "description": "AutoTest AI - Node.js API Server (migrated from Python FastAPI)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:execution": "tsx src/workers/execution.worker.ts",
    "worker:healing": "tsx src/workers/healing.worker.ts",
    "worker:notification": "tsx src/workers/notification.worker.ts"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/formbody": "^7.4.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.2",
    "@prisma/client": "^5.18.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "bcryptjs": "^2.4.3",
    "@langchain/core": "^0.3.1",
    "@langchain/openai": "^0.3.0",
    "@langchain/anthropic": "^0.3.0",
    "openai": "^4.56.0",
    "@playwright/test": "^1.46.0",
    "jsforce": "^3.4.1",
    "uuid": "^10.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "supertest": "^7.0.0",
    "@types/node": "^22.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.16.5"
  }
}
